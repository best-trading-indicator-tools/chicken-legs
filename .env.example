# Copy to .env.local and fill values locally. Never commit real secrets.
# Sandbox only during implementation. Hosted Checkout needs no publishable key.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICING_MODEL=standard
CHECKOUT_ENABLED=false
LIVE_PAYMENTS_CONFIRMED=false
WORKER_SECRET=

# Configure during application setup.
DATABASE_URL=
APP_URL=http://localhost:3000

# Optional separate local test database; never point at production.
TEST_DATABASE_URL=
